# Copy to .env and fill in. .env is gitignored — NEVER commit real credentials.

# --- Backend selection (defaults shown) ---
LLM_PROVIDER=ollama          # ollama | bedrock
RETRIEVAL_BACKEND=chroma     # chroma | kb
OLLAMA_MODEL=llama3.2:3b

# --- AWS (only needed for bedrock / kb backends) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
KB_ID=
CHAT_MODEL_ID=us.amazon.nova-lite-v1:0
NUM_RESULTS=4
